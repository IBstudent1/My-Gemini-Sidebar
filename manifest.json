{
  "manifest_version": 3,
  "name": "My Gemini Sidebar",
  "version": "1.0",
  "description": "Unlocks Gemini in the side panel",
  "permissions": ["sidePanel", "declarativeNetRequest"],
  "host_permissions": ["https://gemini.google.com/*"],
  "icons": {
    "16": "icon128.png",
    "48": "icon128.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Open Gemini",
    "default_icon": "icon128.png"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "declarative_net_request": {
    "rule_resources": [{
      "id": "ruleset_1",
      "enabled": true,
      "path": "rules.json"
    }]
  }
}